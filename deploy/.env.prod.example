# Copy to deploy/.env.prod and fill in. Never commit the real file.

# Address users, players and Keycloak redirects use (no trailing slash).
PUBLIC_URL=http://192.168.0.10
PUBLIC_PORT=80

# Direct S3 downloads (players, previews): host reachable on the LAN + S3_PUBLIC_PORT.
S3_PUBLIC_URL=http://192.168.0.10:8333
S3_PUBLIC_PORT=8333
S3_ACCESS_KEY=webpresenter
S3_SECRET_KEY=change-me-long-random

# Filer ports exposed for replication.
FILER_PORT=8888
FILER_GRPC_PORT=18888

DB_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# First webpresenter user (all roles). Created on the first start only.
WEBPRESENTER_ADMIN_USER=admin
WEBPRESENTER_ADMIN_PASSWORD=change-me
WEBPRESENTER_ADMIN_EMAIL=admin@example.org

# Other SeaweedFS filer for --profile replication: host:port (gRPC = port + 10000),
# or host:port.grpcPort when the gRPC port is mapped differently.
REPLICA_FILER=192.168.0.20:8888
