# Browsers need HTTPS (Keycloak's login uses Web Crypto, only available in secure contexts), so
# Caddy serves HTTPS with its own local certificate authority: install its root certificate once per
# device (see docs/deployment.md). MediaPlayers use plain HTTP on the LAN through a separate port.
#
# Nothing here depends on this computer's address: certificates are issued on demand for the
# name (or address) a browser uses, and media links are relative (/s3/…).
{
	# IP addresses carry no SNI: present the certificate of the announced name.
	default_sni {$PUBLIC_NAME}
	# The internal CA lives in the caddy-data volume; nothing is fetched from the internet.
	local_certs
	skip_install_trust
	# Port 80 serves MediaPlayers over HTTP; no automatic HTTP→HTTPS redirect there.
	auto_https disable_redirects
	# Certificates for any name the server is reached by on the LAN (its own CA; the server only
	# answers on the LAN).
	on_demand_tls {
		ask http://server:8090/actuator/health
	}
}

(media) {
	# Presigned links are made for the host "webpresenter-s3"; the store checks the signature
	# against the host it receives, so that host is set back here.
	handle_path /s3/* {
		reverse_proxy seaweedfs:8333 {
			header_up Host webpresenter-s3
			# SeaweedFS checks signatures against X-Forwarded-Host/Port when present.
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Port
			header_up -X-Forwarded-Proto
		}
	}
}

# Web app, API, live stream, Keycloak (/auth) and media for browsers, on any name.
https:// {
	tls internal {
		on_demand
	}
	encode zstd gzip
	import media

	@keycloak path /auth /auth/*
	reverse_proxy @keycloak keycloak:8080

	reverse_proxy server:8090 {
		# Live state is streamed (Server-Sent Events): pass bytes through as they come.
		flush_interval -1
	}
}

# MediaPlayers (WebSocket, media) and the root certificate download, over plain HTTP on the LAN.
http://:80 {
	import media
	handle /webpresenter-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle /ws/player {
		reverse_proxy server:8090
	}
	handle /actuator/health {
		reverse_proxy server:8090
	}
	handle {
		respond "webpresenter: open https://{$PUBLIC_NAME} in the browser" 404
	}
}
