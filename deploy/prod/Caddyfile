# Browsers need HTTPS (Keycloak's login uses Web Crypto, only available in secure contexts), so
# Caddy serves HTTPS with its own local certificate authority: install its root certificate once per
# device (see docs/deployment.md). MediaPlayers use plain HTTP on the LAN through a separate port.
#
# Nothing here depends on this computer's address. Caddy runs on the host network, so it knows
# which address a client connected to: certificates are issued on demand by the local CA for that
# address (https://<IP>:PUBLIC_PORT) or for the name used (https://webpresenter.local:PUBLIC_PORT).
# Media links are relative (/s3/…).
{
	# The internal CA lives in the caddy-data volume; nothing is fetched from the internet.
	local_certs
	skip_install_trust
	# The player port serves MediaPlayers over HTTP; no automatic HTTP→HTTPS redirect there.
	auto_https disable_redirects
	# Certificates for any name or address the server is reached by on the LAN (its own CA).
	on_demand_tls {
		ask http://{$SERVER_LOCAL}/actuator/health
	}
}

(media) {
	# Presigned links are made for the host "webpresenter-s3"; the store checks the signature
	# against the host it receives, so that host is set back here.
	handle_path /s3/* {
		reverse_proxy {$S3_LOCAL} {
			header_up Host webpresenter-s3
			# SeaweedFS checks signatures against X-Forwarded-Host/Port when present.
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Port
			header_up -X-Forwarded-Proto
		}
	}
}

# Web app, API, live stream, Keycloak (/auth) and media for browsers, on any name or address.
https://:{$PUBLIC_PORT} {
	tls internal {
		on_demand
	}
	encode zstd gzip
	import media

	@keycloak path /auth /auth/*
	reverse_proxy @keycloak {$KEYCLOAK_LOCAL}

	reverse_proxy {$SERVER_LOCAL} {
		# Live state is streamed (Server-Sent Events): pass bytes through as they come.
		flush_interval -1
	}
}

# MediaPlayers (WebSocket, media), the root certificate and a landing page, over plain HTTP.
http://:{$PLAYER_PORT} {
	import media
	handle /webpresenter-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle /ws/player {
		reverse_proxy {$SERVER_LOCAL}
	}
	handle /actuator/health {
		reverse_proxy {$SERVER_LOCAL}
	}
	# Someone opened the players' port in a browser: show where the panel is (this same address).
	handle {
		root * /srv
		rewrite * /landing.html
		templates
		header Content-Type "text/html; charset=utf-8"
		file_server
	}
}
